{
  "version": 1,
  "deniedTools": [],
  "allowedTools": [],
  "fileRules": [
    { "pattern": "**", "read": "allow", "write": "allow" }
  ],
  "destructiveCommandPatterns": [
    "rm -rf",
    "format c:"
  ],
  "destructiveCommandTokens": [
    "rm",
    "rmdir",
    "del",
    "erase",
    "unlink",
    "shred",
    "remove-item"
  ],
  "secretWritePatterns": [
    "aws_access_key_id",
    "x-api-key_live",
    "sk_live_",
    "-----BEGIN PRIVATE KEY-----"
  ],
  "excludePaths": [
    "docs/**"
  ],
  "limits": {
    "maxToolCallsPerTask": 1000,
    "maxFileWritesPerTask": 500,
    "maxBytesPerWrite": 5000000
  },
  "onViolation": "block"
}